---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import UnitCard from '../components/UnitCard.astro';
import SmartImage from '../components/SmartImage.astro';
import FinancingSection from '../components/FinancingSection.astro';
import LocationHighlights from '../components/LocationHighlights.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { business, SITE_URL, OG_IMAGE } from '../data/site';
import { units } from '../data/units';
import { mediaById, type Media } from '../data/media';
import { localizePath, formatNumber, type Lang } from '../i18n/ui';

const lang: Lang = (Astro.props as { lang?: Lang }).lang ?? 'ar';
const L = (p: string) => localizePath(p, lang);

const copy = {
  ar: {
    title: 'مجمع الصفا السكني | شقق سكنية حديثة في البيبان، البصرة',
    description:
      'مجمع الصفا السكني في منطقة البيبان بقضاء شط العرب في البصرة: شقق سكنية حديثة للعائلات مع خيارات تمويل مصرفي ميسّرة. اطلب معاينة في مركز المبيعات اليوم.',
    aboutEyebrow: 'عن المشروع',
    aboutTitle: 'سكنٌ عصري يليق بعائلتك',
    aboutBody:
      'مجمع الصفا السكني مشروع أبراج سكنية حديثة في منطقة البيبان بقضاء شط العرب في البصرة، شعاره «حياة تستحقها». يجمع المشروع بين الطابع العصري وخيارات تمويل مصرفي ميسّرة، ويستقبلكم فريقه في مركزين للمبيعات لمساعدتكم في اختيار شقتكم.',
    aboutMore: 'اقرأ المزيد عن المشروع',
    features: [
      { icon: 'family', title: 'موجّه للعائلات', body: 'حياة تستحقها أنت وعائلتك، براحة ورفاهية.' },
      { icon: 'building', title: 'طابع حديث', body: 'أبراج سكنية بتصميم معماري عصري.' },
      { icon: 'bank', title: 'تمويل مصرفي', body: 'قروض عبر مصرف الرافدين والمصرف العراقي للتجارة.' },
      { icon: 'map-pin', title: 'مركزا مبيعات', body: 'في البيبان وشارع السعدي لاستقبال استفساراتكم.' },
    ],
    stats: [
      { value: formatNumber(business.rating, 'ar'), label: `تقييم Google من ${formatNumber(business.reviewCount, 'ar')} مراجعات` },
      { value: formatNumber(business.instagram.followers, 'ar'), label: 'متابع على إنستغرام' },
      { value: formatNumber(20, 'ar'), label: 'عاماً حداً أقصى للسداد عبر مصرف الرافدين' },
      { value: 'قريباً', label: 'إجمالي عدد الوحدات' },
    ],
    statsLabel: 'أرقام سريعة عن المشروع',
    featuredEyebrow: 'وحدات مختارة',
    featuredTitle: 'اكتشف نماذج الشقق',
    featuredIntro:
      'تُنشر المساحات والأسعار وحالة التوفر فور اعتمادها من إدارة المشروع. يمكنك طلب التفاصيل الكاملة مباشرةً من فريق المبيعات.',
    viewAll: 'عرض جميع الوحدات',
    galleryEyebrow: 'معرض الصور',
    galleryTitle: 'لمحة من مجمع الصفا',
    galleryIntro: 'صور من خرائط Google ومن الحساب الرسمي للمشروع على إنستغرام.',
    galleryCta: 'استعرض المعرض الكامل',
    openInGallery: 'افتح في المعرض',
    inquiryEyebrow: 'ابدأ خطوتك',
    inquiryTitle: 'احجز معاينتك لمجمع الصفا',
    inquiryBody: 'اترك اسمك ورقم هاتفك، وسيتواصل معك فريق المبيعات لتحديد موعد مناسب لزيارة المشروع.',
    fullForm: 'انتقل إلى نموذج الطلب الكامل',
    orCall: 'أو اتصل بمركز المبيعات مباشرةً',
    quickFormLabel: 'نموذج طلب معاينة سريع',
  },
  en: {
    title: 'Al Safa Residence | Modern Apartments in Al-Beban, Basra',
    description:
      'Al Safa Residence in Al-Beban, Shatt Al-Arab, Basra: modern family apartments with flexible bank financing. Request a viewing at our sales centre today.',
    aboutEyebrow: 'The project',
    aboutTitle: 'Contemporary living, designed around family life',
    aboutBody:
      'Al Safa Residence is a development of modern residential towers in Al-Beban, Shatt Al-Arab District, Basra — built on the promise of “a life you deserve”. It pairs contemporary design with accessible bank financing, and two sales centres are ready to help you choose your home.',
    aboutMore: 'More about the project',
    features: [
      { icon: 'family', title: 'Family-focused', body: 'A comfortable, refined life for you and your family.' },
      { icon: 'building', title: 'Modern towers', body: 'Residential towers with a contemporary architectural style.' },
      { icon: 'bank', title: 'Bank financing', body: 'Loans through Rafidain Bank and the Trade Bank of Iraq.' },
      { icon: 'map-pin', title: 'Two sales centres', body: 'In Al-Beban and on Al-Saadi Street, ready for your questions.' },
    ],
    stats: [
      { value: formatNumber(business.rating, 'en'), label: `Google rating from ${business.reviewCount} reviews` },
      { value: formatNumber(business.instagram.followers, 'en'), label: 'Instagram followers' },
      { value: '20 yrs', label: 'Maximum repayment term via Rafidain Bank' },
      { value: 'Coming soon', label: 'Total number of units' },
    ],
    statsLabel: 'Project at a glance',
    featuredEyebrow: 'Featured units',
    featuredTitle: 'Explore our apartment models',
    featuredIntro:
      'Floor areas, prices and availability will be published as soon as the project team confirms them. Ask our sales team for full details today.',
    viewAll: 'View all units',
    galleryEyebrow: 'Gallery',
    galleryTitle: 'A glimpse of Al Safa',
    galleryIntro: 'Photos from Google Maps and the project’s official Instagram account.',
    galleryCta: 'Open the full gallery',
    openInGallery: 'Open in gallery',
    inquiryEyebrow: 'Take the first step',
    inquiryTitle: 'Book your viewing at Al Safa',
    inquiryBody: 'Leave your name and phone number and our sales team will call you to arrange a convenient time to visit.',
    fullForm: 'Go to the full inquiry form',
    orCall: 'Or call the sales centre directly',
    quickFormLabel: 'Quick viewing request form',
  },
}[lang];

const featured = units.filter((u) => u.featured).slice(0, 3);
const galleryPreview = ['g1', 'ig1', 'g3', 'ig3'].map((id) => mediaById(id)).filter((m): m is Media => Boolean(m));
const hero = mediaById('g1');
const mainBranch = business.branches[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: business.name[lang],
  alternateName: business.name[lang === 'ar' ? 'en' : 'ar'],
  slogan: business.tagline[lang],
  url: new URL(L('/'), SITE_URL).href,
  image: OG_IMAGE,
  telephone: mainBranch.phones[0].tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: lang === 'ar' ? 'منطقة البيبان، قضاء شط العرب' : 'Al-Beban, Shatt Al-Arab District',
    addressLocality: lang === 'ar' ? 'البصرة' : 'Basra',
    addressCountry: 'IQ',
  },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: business.rating, reviewCount: business.reviewCount, bestRating: 5 },
  sameAs: [business.instagram.url],
};
---

<Layout
  lang={lang}
  title={copy.title}
  description={copy.description}
  path="/"
  jsonLd={jsonLd}
  preload={hero ? { src: hero.src, srcset: hero.srcset, sizes: lang === 'ar' ? '100vw' : '(min-width: 1024px) 50vw, 100vw' } : undefined}
>
  <Hero lang={lang} />

  <!-- 2. About the project -->
  <section aria-labelledby="about-heading" class="py-20 lg:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <SectionHeading id="about-heading" eyebrow={copy.aboutEyebrow} title={copy.aboutTitle} intro={copy.aboutBody} />
        <a href={L('/about/')} class="btn-ghost mt-8">
          {copy.aboutMore}
          <Icon name="arrow" class="h-5 w-5 rtl:-scale-x-100" />
        </a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7" role="list">
        {copy.features.map((f) => (
          <li class="card p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-river-100 text-river">
              <Icon name={f.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 text-lg font-bold">{f.title}</h3>
            <p class="mt-1.5 text-ink/80">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="container-x mt-14">
      <dl aria-label={copy.statsLabel} class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-sand bg-sand lg:grid-cols-4">
        {copy.stats.map((s) => (
          <div class="flex flex-col-reverse gap-1 bg-ivory-50 p-6">
            <dt class="text-sm text-ink/80">{s.label}</dt>
            <dd class="font-display text-2xl font-bold text-river sm:text-3xl"><bdi>{s.value}</bdi></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 3. Featured units -->
  <section aria-labelledby="featured-heading" class="bg-sand-50 py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="featured-heading" eyebrow={copy.featuredEyebrow} title={copy.featuredTitle} intro={copy.featuredIntro} />
        <a href={L('/properties/')} class="btn-dark shrink-0">
          {copy.viewAll}
          <Icon name="arrow" class="h-5 w-5 rtl:-scale-x-100" />
        </a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {featured.map((unit) => (
          <li><UnitCard unit={unit} lang={lang} /></li>
        ))}
      </ul>
    </div>
  </section>

  <FinancingSection lang={lang} />

  <!-- 4. Gallery preview -->
  <section aria-labelledby="gallery-heading" class="py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="gallery-heading" eyebrow={copy.galleryEyebrow} title={copy.galleryTitle} intro={copy.galleryIntro} />
        <a href={L('/gallery/')} class="btn-ghost shrink-0">
          {copy.galleryCta}
          <Icon name="arrow" class="h-5 w-5 rtl:-scale-x-100" />
        </a>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" role="list" data-dynamic data-offline-label={lang === 'ar' ? 'الصور غير متاحة دون اتصال' : 'Images unavailable offline'}>
        {galleryPreview.map((m, i) => (
          <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
            <a href={L('/gallery/')} class="group block overflow-hidden rounded-3xl" aria-label={`${copy.openInGallery}: ${m.alt[lang]}`}>
              <SmartImage
                src={m.src}
                srcset={m.srcset}
                sizes={i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
                alt={m.alt[lang]}
                width={m.width}
                height={m.height}
                ratio="1/1"
                lang={lang}
                imgClass="transition-transform duration-500 group-hover:scale-105"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Location highlights -->
  <LocationHighlights lang={lang} />

  <ReviewsSection lang={lang} />

  <InstagramFeed lang={lang} limit={6} />

  <!-- 6. Inquiry prompt -->
  <section aria-labelledby="quick-inquiry-heading" class="py-20 lg:py-28">
    <div class="container-x">
      <div class="grid overflow-hidden rounded-[2rem] bg-river text-ivory shadow-soft lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <SectionHeading id="quick-inquiry-heading" eyebrow={copy.inquiryEyebrow} title={copy.inquiryTitle} intro={copy.inquiryBody} dark />
          <a href={`${L('/contact/')}#inquiry`} class="btn-light mt-8">
            {copy.fullForm}
            <Icon name="arrow" class="h-5 w-5 rtl:-scale-x-100" />
          </a>
          <p class="mt-8 text-sand">{copy.orCall}</p>
          <ul class="mt-3 flex flex-wrap gap-3" role="list">
            {mainBranch.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`} class="btn border border-white/30 text-ivory hover:bg-white/10">
                  <Icon name="phone" class="h-5 w-5" />
                  <bdi dir="ltr">{p.display}</bdi>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-ivory p-6 text-ink sm:p-10">
          <InquiryForm lang={lang} id="quick-inquiry" compact label={copy.quickFormLabel} />
        </div>
      </div>
    </div>
  </section>
</Layout>