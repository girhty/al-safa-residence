---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompareTray from '../components/CompareTray.astro';
import { SITE_URL, OG_IMAGE } from '../data/site';
import { localizePath, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Locale-neutral path, e.g. "/properties/" */
  path: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  preload?: { src: string; srcset?: string; sizes?: string };
}

const { lang, title, description, path, ogImage = OG_IMAGE, jsonLd, noindex = false, preload } = Astro.props;
const t = ui[lang];
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const abs = (p: string) => new URL(p, SITE_URL).href;
const canonical = abs(localizePath(path, lang));
const arUrl = abs(localizePath(path, 'ar'));
const enUrl = abs(localizePath(path, 'en'));
const FONTS =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Noto+Kufi+Arabic:wght@500;600;700;800&display=swap';
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="ar" href={arUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={arUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_IQ' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_IQ'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0E3A47" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://lh3.googleusercontent.com" crossorigin />
    {preload && (
      <link rel="preload" as="image" href={preload.src} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />
    )}
    <!-- Non-render-blocking web fonts (Arabic glyph coverage verified: IBM Plex Sans Arabic, Noto Kufi Arabic) -->
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={FONTS} />
      <style>.smart-img img{opacity:1!important}.smart-img{animation:none!important}</style>
    </noscript>

    {ldList.map((ld) => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="btn-dark sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[70]">{t.skip}</a>
    <div id="offline-banner" hidden role="status" class="bg-bronze-700 px-4 py-2 text-center text-sm font-medium text-white">
      {t.offline}
    </div>
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1" class="flex-1 focus:shadow-none focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
    <CompareTray lang={lang} />

    <script>
      // ── Offline detection: label dynamic areas as unavailable ─────────
      const root = document.documentElement;
      const banner = document.getElementById('offline-banner');
      const setOffline = () => {
        const off = !navigator.onLine;
        root.dataset.offline = String(off);
        if (banner) banner.hidden = !off;
      };
      window.addEventListener('online', setOffline);
      window.addEventListener('offline', setOffline);
      setOffline();

      // ── Language switch: keep page, query (filters / QA flags), hash and scroll position ──
      const KEY = 'alsafa:langswitch';
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const target = new URL(a.href, location.href);
            target.search = location.search;
            target.hash = location.hash;
            sessionStorage.setItem(KEY, JSON.stringify({ path: target.pathname, ratio: max > 0 ? window.scrollY / max : 0 }));
            a.href = target.href;
          } catch {
            /* storage unavailable — plain navigation still works */
          }
        });
      });
      try {
        const raw = sessionStorage.getItem(KEY);
        if (raw) {
          sessionStorage.removeItem(KEY);
          const { path, ratio } = JSON.parse(raw) as { path: string; ratio: number };
          if (path === location.pathname && !location.hash) {
            const go = () => {
              const max = document.documentElement.scrollHeight - window.innerHeight;
              window.scrollTo({ top: Math.max(0, ratio * max), behavior: 'instant' as ScrollBehavior });
            };
            requestAnimationFrame(go);
            window.addEventListener('load', go, { once: true });
          }
        }
      } catch {
        /* ignore */
      }
    </script>
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}
  </body>
</html>