---
import Logo from './Logo.astro';
import { contact } from '../data/site';

const links = [
  { href: '#philosophy', label: 'Philosophy' },
  { href: '#masterplan', label: 'Master Plan' },
  { href: '#gallery', label: 'Life at the City' },
  { href: '#location', label: 'Location' }
];
---

<header id="site-header" data-header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-700 ease-out-expo">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 lg:px-8">
    <a href="#top" class="group flex items-center gap-3" aria-label="Al Safa Residence — back to top">
      <Logo size={48} class="transition-transform duration-700 ease-out-expo group-hover:rotate-[30deg]" />
      <span class="hidden leading-tight sm:block">
        <span class="block font-display text-[11px] tracking-[0.38em] text-marble">AL SAFA</span>
        <span class="mt-1 block font-mono text-[9px] tracking-[0.32em] text-gold">RESIDENCE · BASRAH</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-9">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="group relative py-2 text-[11px] font-medium uppercase tracking-[0.28em] text-marble/75 transition-colors hover:text-gold-light"
              >
                {l.label}
                <span class="absolute inset-x-0 -bottom-0.5 h-px origin-left scale-x-0 bg-gold transition-transform duration-700 ease-out-expo group-hover:scale-x-100" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${contact.phoneTel}`}
        class="hidden items-center gap-2 font-mono text-[11px] tracking-wider text-marble/70 transition-colors hover:text-gold xl:inline-flex"
        aria-label={`Call ${contact.phoneDisplay}`}
      >
        <svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
        {contact.phoneDisplay}
      </a>
      <a href="#inquiry" class="btn-gold !px-4 !py-3 !text-[10px] sm:!px-5">Private Viewing</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center border border-gold/40 text-gold lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path data-menu-icon="open" d="M4 7h16M8 12h12M4 17h16"></path>
          <path data-menu-icon="close" class="hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="glass-dark hidden border-t border-gold/20 lg:hidden" data-mobile-nav>
    <nav aria-label="Mobile" class="px-5 py-6">
      <ul class="space-y-1">
        {
          links.map((l, i) => (
            <li>
              <a href={l.href} class="flex items-center justify-between border-b border-white/5 py-4 font-display text-xs tracking-[0.3em] text-marble" data-mobile-link>
                {l.label.toUpperCase()}
                <span class="font-mono text-[10px] text-gold">0{i + 1}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={`tel:${contact.phoneTel}`} class="mt-6 block font-mono text-sm text-gold">{contact.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 40;
      header.classList.toggle('glass-dark', scrolled);
      header.classList.toggle('!border-gold/15', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('hidden', !open);
      toggle.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-menu-icon="close"]')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  }
</script>