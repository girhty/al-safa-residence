---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { localizePath, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const items = [
  { href: '/', label: t.nav.home },
  { href: '/properties/', label: t.nav.properties },
  { href: '/gallery/', label: t.nav.gallery },
  { href: '/about/', label: t.nav.about },
  { href: '/contact/', label: t.nav.contact },
];
const isActive = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
const switchHref = localizePath(path, other);
---

<header class="sticky top-0 z-40 border-b border-sand bg-ivory/95 backdrop-blur supports-[backdrop-filter]:bg-ivory/85">
  <div class="container-x flex h-16 items-center justify-between gap-3 lg:h-20">
    <a href={localizePath('/', lang)} class="flex min-h-[44px] items-center gap-3" aria-label={t.homeLink}>
      <Logo class="h-10 w-10 shrink-0 lg:h-11 lg:w-11" />
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base font-bold text-river sm:text-lg">{t.siteName}</span>
        <span class="hidden text-xs text-ink/75 sm:block">{t.tagline}</span>
      </span>
    </a>

    <nav aria-label={t.navLabel} class="hidden lg:block">
      <ul class="flex items-center gap-1" role="list">
        {items.map((it) => (
          <li>
            <a
              href={localizePath(it.href, lang)}
              aria-current={isActive(it.href) ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-[44px] items-center rounded-full px-4 font-medium transition-colors',
                isActive(it.href) ? 'bg-river text-ivory' : 'text-river hover:bg-river/5',
              ]}
            >
              {it.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        data-lang-switch
        aria-label={t.langSwitchLabel}
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-1.5 rounded-full border border-river/25 px-3 text-sm font-semibold text-river hover:bg-river/5"
      >
        <Icon name="globe" class="h-4 w-4" />
        <span>{t.langSwitch}</span>
      </a>
      <a href={`${localizePath('/contact/', lang)}#inquiry`} class="btn-primary hidden sm:inline-flex">{t.cta}</a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-river hover:bg-river/5 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.menuOpen}
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="fixed inset-0 z-50 lg:hidden" role="dialog" aria-modal="true" aria-label={t.navLabel}>
    <div class="absolute inset-0 bg-river-900/60" data-menu-close aria-hidden="true"></div>
    <div class="absolute inset-y-0 end-0 flex w-[min(88vw,22rem)] flex-col overflow-y-auto bg-ivory p-5 shadow-2xl">
      <div class="flex items-center justify-between gap-3">
        <span class="font-display text-lg font-bold text-river">{t.siteName}</span>
        <button type="button" data-menu-close class="inline-flex h-11 w-11 items-center justify-center rounded-full text-river hover:bg-river/5" aria-label={t.menuClose}>
          <Icon name="x" class="h-6 w-6" />
        </button>
      </div>
      <nav aria-label={t.navLabel} class="mt-6">
        <ul class="flex flex-col gap-1" role="list">
          {items.map((it) => (
            <li>
              <a
                href={localizePath(it.href, lang)}
                aria-current={isActive(it.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-[48px] items-center rounded-2xl px-4 text-lg font-medium',
                  isActive(it.href) ? 'bg-river text-ivory' : 'text-river hover:bg-river/5',
                ]}
              >
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={`${localizePath('/contact/', lang)}#inquiry`} class="btn-primary mt-6 w-full">{t.cta}</a>
      <a href={switchHref} hreflang={other} lang={other} data-lang-switch class="btn-ghost mt-3 w-full" aria-label={t.langSwitchLabel}>
        <Icon name="globe" class="h-5 w-5" />
        {t.langSwitch}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;

  if (toggle && menu) {
    const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
    function open() {
      menu!.hidden = false;
      toggle!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      focusables()[0]?.focus();
    }
    function close() {
      menu!.hidden = true;
      toggle!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      toggle!.focus();
    }
    toggle.addEventListener('click', () => (menu.hidden ? open() : close()));
    menu.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) close();
    });
  }
</script>