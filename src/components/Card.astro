---
interface Props {
  title: string;
  body: string;
  href?: string;
  icon?: string;
}

const { href, title, body, icon } = Astro.props;
---

<div class="p-6 bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md transition-shadow">
  {icon && <div class="text-3xl mb-4">{icon}</div>}
  <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
    {href ? (
      <a href={href} class="hover:text-teal-600 dark:hover:text-teal-400 focus:outline-none focus:underline">
        {title} &rarr;
      </a>
    ) : (
      title
    )}
  </h3>
  <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
    {body}
  </p>
</div>
