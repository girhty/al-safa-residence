---
import { instagram, contact } from '../data/site';

const pillars = [
  {
    n: '01',
    title: 'Sculptural Design',
    ar: 'تصميم نحتي',
    text: 'Faceted façades, chamfered volumes and interlocking geometries — architecture composed with mathematical precision and softened by warm metallic light.',
    icon: 'M12 2l9 5v10l-9 5-9-5V7z M12 2v20 M3 7l18 10 M21 7L3 17'
  },
  {
    n: '02',
    title: 'Private Sky Mansions',
    ar: 'قصور في السماء',
    text: 'Elevated residences with panoramic glazing, generous terraces and layouts conceived for multigenerational family life above the Shatt Al-Arab.',
    icon: 'M4 21V9l8-6 8 6v12 M9 21v-6h6v6 M4 13h16'
  },
  {
    n: '03',
    title: 'Bespoke Hospitality',
    ar: 'ضيافة استثنائية',
    text: 'A dedicated sales gallery and resident services team — from private presentations to tailored financing guidance with Iraq’s leading banks.',
    icon: 'M3 18h18 M5 18a7 7 0 0 1 14 0 M12 8V5 M10 5h4'
  }
];

const marquee = ['Sculptural', 'حياة تستحقها', 'Riverside', 'Sky Villas', 'مجمع الصفا السكني', 'Penthouses', 'Modernity · حداثة'];
const mainImg = instagram.posts[2].image_url;
const subImg = instagram.posts[0].image_url;
---

<section id="philosophy" class="marble-bg relative overflow-hidden text-obsidian" aria-labelledby="philosophy-title">
  <!-- diagonal slice from hero -->
  <div class="clip-slice-top pointer-events-none absolute inset-x-0 top-0 h-16 bg-obsidian sm:h-24" aria-hidden="true"></div>

  <!-- marquee -->
  <div class="relative mt-20 overflow-hidden border-y border-obsidian/10 py-5 sm:mt-28" aria-hidden="true">
    <div class="flex w-max animate-marquee gap-12 whitespace-nowrap">
      {
        [...marquee, ...marquee].map((w) => (
          <span class="flex items-center gap-12 font-display text-sm tracking-[0.4em] text-obsidian/40">
            {w.toUpperCase()}
            <span class="h-2 w-2 rotate-45 bg-gold" />
          </span>
        ))
      }
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-12 lg:gap-10 lg:px-8 lg:py-28">
    <!-- Typography side -->
    <div class="lg:col-span-6 lg:pr-6">
      <p class="eyebrow reveal !text-bronze">01 — Architectural Philosophy</p>
      <h2 id="philosophy-title" class="headline reveal mt-6 text-[clamp(1.7rem,4vw,3.3rem)] font-bold" style="--d:80ms">
        Sculpted for<br />the life <span class="text-gold-gradient">you deserve</span>
      </h2>
      <p class="reveal mt-4 font-arabic text-xl text-obsidian/70" dir="rtl" lang="ar" style="--d:140ms">حياة تستحقها، مليئة بالراحة والرفاهية</p>
      <div class="reveal mt-8 space-y-5 font-serif text-xl leading-relaxed text-obsidian/75" style="--d:200ms">
        <p>
          Al Safa Residence reimagines riverside living in Basrah. Set in the Shatt Al-Arab district at Al-Beban, the community is composed as a complete city —
          towers, sky villas, gardens and a retail promenade arranged with the clarity of a blueprint and the warmth of a home.
        </p>
        <p>Every line is intentional: sharp diagonals that catch the light, glazing that frames the river, and interiors tuned for comfort in every season.</p>
      </div>

      <dl class="reveal mt-10 grid grid-cols-2 gap-px border border-obsidian/10 bg-obsidian/10 font-mono text-xs" style="--d:260ms">
        {
          [
            ['Location', 'Shatt Al-Arab · Al-Beban'],
            ['Sales Gallery', contact.hours + ' daily'],
            ['Bank Financing', 'Up to 20 years'],
            ['Plus Code', contact.plusCode]
          ].map(([k, v]) => (
            <div class="bg-marble p-4">
              <dt class="text-[10px] uppercase tracking-[0.28em] text-bronze">{k}</dt>
              <dd class="mt-1.5 text-sm text-obsidian">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Visual side -->
    <div class="relative lg:col-span-6">
      <div class="reveal relative mx-auto max-w-lg" style="--d:120ms">
        <div class="absolute -right-4 -top-4 h-full w-full border border-gold/60" aria-hidden="true"></div>
        <div data-tilt="5" class="relative will-change-transform">
          <div data-media class="skeleton-light clip-chamfer relative aspect-[4/5] overflow-hidden bg-marble-300">
            <img
              data-skeleton
              src={mainImg}
              alt="Al Safa Residence — family lifestyle at the residential city"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              width="640"
              height="800"
            />
            <div class="media-fallback absolute inset-0 items-center justify-center bg-gradient-to-br from-charcoal to-obsidian">
              <span class="font-display text-xs tracking-[0.4em] text-gold">AL SAFA</span>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/70 via-transparent to-transparent"></div>
            <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="125" x2="100" y2="40" stroke="#D4AF37" stroke-width="0.25" opacity="0.8"></line>
              <line x1="0" y1="110" x2="100" y2="25" stroke="#D4AF37" stroke-width="0.12" opacity="0.5"></line>
            </svg>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="font-mono text-[10px] tracking-[0.3em] text-gold-light">RESIDENTIAL · RIVERSIDE · BASRAH</p>
              <p class="mt-2 font-arabic text-lg text-marble" dir="rtl" lang="ar">حياة تستحقها انت وعائلتك</p>
            </div>
          </div>
        </div>
        <div class="glass-dark clip-chamfer-sm absolute -bottom-8 -left-4 hidden w-48 p-2 sm:block lg:-left-12">
          <div data-media class="skeleton relative aspect-square overflow-hidden">
            <img data-skeleton src={subImg} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" referrerpolicy="no-referrer" width="200" height="200" />
          </div>
          <p class="px-1 pb-1 pt-2 font-mono text-[9px] tracking-[0.25em] text-gold">@alsafaresidence</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Pillars -->
  <div class="mx-auto max-w-7xl px-5 pb-28 lg:px-8">
    <ul class="grid gap-5 md:grid-cols-3" role="list">
      {
        pillars.map((p, i) => (
          <li class="reveal" style={`--d:${i * 120}ms`}>
            <article class="clip-chamfer group relative h-full overflow-hidden bg-obsidian p-8 text-marble transition-transform duration-700 ease-out-expo hover:-translate-y-2 lg:p-10">
              <div class="grid-lines pointer-events-none absolute inset-0 opacity-50" />
              <div class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rotate-45 border border-gold/20 transition-all duration-1000 ease-out-expo group-hover:rotate-[135deg] group-hover:border-ember/50" />
              <div class="relative">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs tracking-[0.3em] text-gold">{p.n}</span>
                  <svg class="h-9 w-9 text-gold transition-colors duration-500 group-hover:text-ember" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                    <path d={p.icon} />
                  </svg>
                </div>
                <h3 class="mt-10 font-display text-base font-bold uppercase tracking-[0.16em]">{p.title}</h3>
                <p class="mt-1 font-arabic text-sm text-gold/80" dir="rtl" lang="ar">{p.ar}</p>
                <div class="my-5 h-px w-12 bg-gold transition-all duration-700 ease-out-expo group-hover:w-24 group-hover:bg-ember" />
                <p class="font-serif text-lg leading-relaxed text-marble/70">{p.text}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>