---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business } from '../data/site';
import { localizePath, formatNumber, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = ui[lang];
const L = (p: string) => localizePath(p, lang);
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const links = [
  { href: '/', label: t.nav.home },
  { href: '/properties/', label: t.nav.properties },
  { href: '/gallery/', label: t.nav.gallery },
  { href: '/about/', label: t.nav.about },
  { href: '/contact/', label: t.nav.contact },
  { href: '/accessibility/', label: t.footer.a11y },
];
const year = new Date().getFullYear();
---

<footer class="bg-river-900 text-sand" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">{t.footer.heading}</h2>
  <div class="container-x grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <div class="flex items-center gap-3">
        <Logo class="h-12 w-12" />
        <p class="font-display text-xl font-bold text-ivory">{t.siteName}</p>
      </div>
      <p class="mt-4 max-w-sm">{t.footer.about}</p>
      <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm text-ivory">
        <Icon name="star" filled class="h-4 w-4 text-bronze-300" />
        <bdi>{formatNumber(business.rating, lang)}</bdi>
        <span>{lang === 'ar' ? `على Google (${formatNumber(business.reviewCount, lang)} مراجعات)` : `on Google (${business.reviewCount} reviews)`}</span>
      </p>
    </div>

    <nav aria-labelledby="footer-links" class="lg:col-span-2">
      <h3 id="footer-links" class="text-base font-bold text-ivory">{t.footer.quick}</h3>
      <ul class="mt-4 space-y-1" role="list">
        {links.map((l) => (
          <li><a href={L(l.href)} class="inline-flex min-h-[44px] items-center hover:text-ivory hover:underline">{l.label}</a></li>
        ))}
        <li>
          <a href={localizePath(path, other)} hreflang={other} lang={other} data-lang-switch class="inline-flex min-h-[44px] items-center hover:text-ivory hover:underline">{t.langSwitch}</a>
        </li>
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h3 class="text-base font-bold text-ivory">{t.footer.contact}</h3>
      <ul class="mt-4 space-y-5" role="list">
        {business.branches.map((b) => (
          <li>
            <p class="font-semibold text-ivory">{b.name[lang]}</p>
            <p class="text-sm">{b.address[lang]}</p>
            <ul class="mt-1 flex flex-wrap gap-x-4" role="list">
              {b.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="inline-flex min-h-[44px] items-center gap-1.5 hover:text-ivory hover:underline">
                    <Icon name="phone" class="h-4 w-4" />
                    <bdi dir="ltr">{p.display}</bdi>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h3 class="text-base font-bold text-ivory">{t.footer.hours}</h3>
      <p class="mt-4 flex items-start gap-2"><Icon name="clock" class="mt-1 h-5 w-5 shrink-0" />{business.hours[lang]}</p>
      <p class="mt-1 text-sm text-sand/90">{business.hoursNote[lang]}</p>

      <h3 class="mt-8 text-base font-bold text-ivory">{t.footer.email}</h3>
      <p class="mt-2 flex items-center gap-2">
        <Icon name="mail" class="h-5 w-5" />
        <span class="rounded-md border border-dashed border-sand/60 px-2 py-0.5 text-sm">{t.unconfigured}</span>
      </p>

      <h3 class="mt-8 text-base font-bold text-ivory">{t.footer.follow}</h3>
      <a
        href={business.instagram.url}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-flex min-h-[44px] items-center gap-2 hover:text-ivory hover:underline"
        aria-label={lang === 'ar' ? 'حساب مجمع الصفا السكني على إنستغرام (يفتح في نافذة جديدة)' : 'Al Safa Residence on Instagram (opens in a new tab)'}
      >
        <Icon name="instagram" class="h-5 w-5" />
        <bdi dir="ltr">@{business.instagram.handle}</bdi>
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>© <bdi>{year}</bdi> {t.siteName}. {t.footer.rights}</p>
      <p class="text-sand/90">{t.footer.sourceNote}</p>
    </div>
  </div>
</footer>