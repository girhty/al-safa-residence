---
import Logo from './Logo.astro';
import { contact, instagram, places } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-gold/20 bg-obsidian pb-28 pt-20" aria-labelledby="footer-title">
  <div class="gold-line absolute inset-x-0 top-0 h-px"></div>
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-4">
          <Logo size={64} eager={false} />
          <div>
            <p id="footer-title" class="font-display text-sm font-bold tracking-[0.3em]">AL SAFA</p>
            <p class="font-mono text-[10px] tracking-[0.3em] text-gold">RESIDENCE · BASRAH</p>
          </div>
        </div>
        <p class="mt-6 font-arabic text-lg leading-8 text-marble/80" dir="rtl" lang="ar">مجمع الصفا السكني<br />حيث رفاهية السكن لمستقبل أفضل</p>
        <div class="mt-6 flex items-center gap-3">
          <span class="font-display text-2xl font-bold text-gold">{places.rating.toFixed(1)}</span>
          <span class="text-gold" aria-hidden="true">★★★★★</span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-marble/50">GOOGLE</span>
        </div>
      </div>

      {
        contact.branches.map((b) => (
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.3em] text-gold">{b.name.toUpperCase()}</p>
            <p class="mt-1 font-arabic text-xs text-marble/50" dir="rtl" lang="ar">{b.nameAr}</p>
            <address class="mt-4 not-italic">
              <p class="text-sm text-marble/80">{b.address}</p>
              <p class="mt-1 font-arabic text-sm text-marble/50" dir="rtl" lang="ar">{b.addressAr}</p>
              <ul class="mt-4 space-y-1 font-mono text-sm">
                {b.phones.map((p) => (
                  <li>
                    <a href={`tel:${p.tel}`} class="text-marble/80 transition hover:text-gold">{p.display}</a>
                  </li>
                ))}
              </ul>
            </address>
          </div>
        ))
      }

      <div class="lg:col-span-2">
        <p class="font-mono text-[10px] tracking-[0.3em] text-gold">CONNECT</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-marble/80 hover:text-gold">Instagram · @{instagram.username}</a></li>
          <li><a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="text-marble/80 hover:text-gold">WhatsApp</a></li>
          <li><a href={contact.directionsUrl} target="_blank" rel="noopener noreferrer" class="text-marble/80 hover:text-gold">Directions</a></li>
          <li><a href="#inquiry" class="text-marble/80 hover:text-gold">Private Viewing</a></li>
        </ul>
        <p class="mt-6 font-mono text-[11px] text-marble/50">{contact.hoursLong}</p>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/5 pt-8 sm:flex-row sm:items-center">
      <p class="font-mono text-[10px] tracking-[0.2em] text-marble/40">© {year} AL SAFA RESIDENCE · مجمع الصفا السكني · ALL RIGHTS RESERVED</p>
      <p class="font-mono text-[10px] tracking-[0.2em] text-marble/40">#حياة_تستحقها · #MEC</p>
    </div>
  </div>
  <p class="pointer-events-none absolute -bottom-6 left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-display text-[16vw] font-bold leading-none text-white/[0.025]" aria-hidden="true">AL SAFA</p>
</footer>