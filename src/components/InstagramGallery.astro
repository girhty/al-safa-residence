---
import Logo from './Logo.astro';
import { instagram, contact, cleanCaption, captionBody, hashtags, firstLine, postType } from '../data/site';

const aspects = ['aspect-[4/5]', 'aspect-square', 'aspect-[3/4]', 'aspect-square', 'aspect-[4/5]', 'aspect-[3/4]', 'aspect-square', 'aspect-[4/5]', 'aspect-square', 'aspect-[3/4]'];

const posts = instagram.posts.map((p, i) => ({
  image: p.image_url,
  likes: p.likes,
  caption: cleanCaption(p.caption),
  body: captionBody(p.caption),
  tags: hashtags(p.caption),
  title: firstLine(p.caption),
  type: postType(p.image_url),
  aspect: aspects[i % aspects.length]
}));

const bioLines = instagram.biography.split('\n');
---

<section id="gallery" class="relative overflow-hidden bg-charcoal py-24 lg:py-32" aria-labelledby="gallery-title">
  <div class="pointer-events-none absolute right-0 top-0 h-[600px] w-[600px] translate-x-1/3 rounded-full bg-bronze/10 blur-[140px]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow reveal">03 — Life at the City</p>
        <h2 id="gallery-title" class="headline reveal mt-6 text-[clamp(1.7rem,4vw,3.3rem)] font-bold" style="--d:80ms">
          Residential <span class="text-gold-gradient">highlights</span>
        </h2>
      </div>
      <p class="reveal max-w-md font-serif text-lg italic text-marble/60" style="--d:140ms">Live moments, launches and offers — straight from our official Instagram.</p>
    </div>

    <!-- Metallic HUD social proof banner -->
    <div class="reveal clip-chamfer relative mt-12 overflow-hidden border border-gold/30 bg-gradient-to-r from-obsidian via-charcoal-800 to-obsidian p-6 sm:p-8" style="--d:180ms">
      <div class="gold-line absolute inset-x-0 top-0 h-px"></div>
      <div class="gold-line absolute inset-x-0 bottom-0 h-px opacity-50"></div>
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="flex items-center gap-5 lg:col-span-4">
          <Logo size={76} eager={false} />
          <div class="min-w-0">
            <p class="truncate font-display text-sm font-bold tracking-[0.12em]">AL SAFA RESIDENCE</p>
            <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-mono text-sm text-gold hover:text-ember">@{instagram.username}</a>
            <p class="mt-2 flex items-center gap-2 font-mono text-[10px] tracking-[0.25em] text-marble/50">
              <span class="h-1.5 w-1.5 rounded-full bg-ember"></span> OFFICIAL ACCOUNT
            </p>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-px bg-gold/15 lg:col-span-3">
          <div class="bg-obsidian p-4">
            <dt class="font-mono text-[9px] tracking-[0.28em] text-marble/50">FOLLOWERS</dt>
            <dd class="mt-1 font-display text-xl font-bold text-gold-light sm:text-2xl"><span data-count={instagram.followers_count}>{instagram.followers_count.toLocaleString('en-US')}</span></dd>
          </div>
          <div class="bg-obsidian p-4">
            <dt class="font-mono text-[9px] tracking-[0.28em] text-marble/50">RECENT</dt>
            <dd class="mt-1 font-display text-xl font-bold text-marble sm:text-2xl">{posts.length} <span class="font-mono text-xs font-normal text-marble/50">posts</span></dd>
          </div>
        </dl>
        <div class="lg:col-span-3" dir="rtl" lang="ar">
          {bioLines.map((l, i) => <p class={`font-arabic ${i === 0 ? 'text-base font-semibold text-marble' : 'text-sm text-marble/65'} leading-7`}>{l}</p>)}
        </div>
        <div class="lg:col-span-2 lg:text-right">
          <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-gold w-full lg:w-auto">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
            Follow
          </a>
        </div>
      </div>
    </div>

    <!-- Masonry grid -->
    <ul class="mt-12 columns-1 gap-5 sm:columns-2 lg:columns-3" role="list">
      {
        posts.map((p, i) => (
          <li class="reveal mb-5 break-inside-avoid" style={`--d:${(i % 3) * 90}ms`}>
            <button
              type="button"
              data-ig-open={i}
              class="group relative block w-full overflow-hidden border border-gold/20 bg-obsidian text-left transition-all duration-700 ease-out-expo hover:-translate-y-1 hover:border-gold/70 hover:shadow-[0_30px_80px_-30px_rgba(212,175,55,0.45)] focus-visible:border-ember"
              aria-label={`Open Instagram ${p.type}: ${p.title}`}
            >
              <span data-media class={`skeleton relative block ${p.aspect} overflow-hidden`}>
                <img
                  data-skeleton
                  src={p.image}
                  alt={p.title}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  width="640"
                  height="640"
                  class="absolute inset-0 h-full w-full object-cover group-hover:scale-[1.06]"
                />
                <span class="media-fallback absolute inset-0 flex-col items-center justify-center gap-3 bg-gradient-to-br from-charcoal-700 to-obsidian">
                  <span class="clip-hex h-12 w-12 bg-gold/80" />
                  <span class="font-mono text-[10px] tracking-[0.3em] text-gold">@alsafaresidence</span>
                </span>
                <span class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/20 to-transparent opacity-70 transition-opacity duration-700 group-hover:opacity-95" />
                <span class="ig-sweep" />
                <svg class="ig-lineart pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700 group-hover:opacity-100 group-focus-visible:opacity-100" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <polygon points="50,14 82,32 82,68 50,86 18,68 18,32" fill="none" stroke="#D4AF37" stroke-width="0.4" vector-effect="non-scaling-stroke" />
                  <line x1="0" y1="100" x2="100" y2="0" stroke="#D4AF37" stroke-width="0.3" vector-effect="non-scaling-stroke" />
                  <line x1="18" y1="32" x2="82" y2="68" stroke="#B87333" stroke-width="0.3" vector-effect="non-scaling-stroke" />
                </svg>

                {p.type !== 'post' && (
                  <span class="glass-dark absolute left-3 top-3 flex items-center gap-1.5 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.25em] text-gold-light">
                    {p.type === 'reel' ? (
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                    ) : (
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="7" y="7" width="13" height="13" /><path d="M4 16V4h12" /></svg>
                    )}
                    {p.type}
                  </span>
                )}
                {p.type === 'reel' && (
                  <span class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 scale-75 items-center justify-center opacity-0 transition-all duration-700 ease-out-expo group-hover:scale-100 group-hover:opacity-100">
                    <span class="clip-hex absolute inset-0 bg-gold/90" />
                    <svg class="relative h-5 w-5 text-obsidian" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                )}

                <span class="absolute inset-x-0 bottom-0 block p-5">
                  <span class="block font-arabic text-sm leading-7 text-marble line-clamp-2" dir="rtl" lang="ar">{p.title}</span>
                  <span class="mt-3 flex translate-y-2 items-center justify-between opacity-0 transition-all duration-700 ease-out-expo group-hover:translate-y-0 group-hover:opacity-100">
                    <span class="flex items-center gap-4 font-mono text-[11px] text-gold-light">
                      <span class="flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.5 12 21 12 21z" /></svg>
                        {p.likes > 0 ? p.likes.toLocaleString('en-US') : 'Like'}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
                        Comment
                      </span>
                    </span>
                    <span class="font-mono text-[10px] tracking-[0.25em] text-marble/60">VIEW →</span>
                  </span>
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 text-center">
      <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">View all on Instagram</a>
    </div>
  </div>

  <!-- Modal viewer -->
  <dialog
    id="ig-modal"
    data-posts={JSON.stringify(posts.map(({ image, body, tags, type, likes }) => ({ image, body, tags, type, likes })))}
    class="m-auto w-[min(1080px,94vw)] max-w-none overflow-visible bg-transparent p-0 text-marble"
    aria-label="Instagram post viewer"
  >
    <div class="clip-chamfer grid max-h-[90vh] overflow-hidden border border-gold/30 bg-obsidian md:grid-cols-2">
      <div class="relative aspect-square overflow-hidden bg-charcoal md:aspect-auto md:min-h-[560px]">
        <img data-modal-img src="" alt="" class="absolute inset-0 h-full w-full object-cover" referrerpolicy="no-referrer" />
        <div data-modal-reel class="absolute inset-0 hidden items-center justify-center bg-obsidian/30">
          <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="group relative flex h-20 w-20 items-center justify-center" aria-label="Watch reel on Instagram">
            <span class="absolute inset-0 animate-pulse-ring rounded-full bg-ember/40"></span>
            <span class="clip-hex absolute inset-0 bg-gold transition group-hover:bg-ember"></span>
            <svg class="relative h-7 w-7 text-obsidian" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          </a>
        </div>
        <span data-modal-type class="glass-dark absolute left-4 top-4 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.25em] text-gold-light">post</span>
      </div>
      <div class="flex max-h-[90vh] flex-col overflow-hidden">
        <div class="flex items-center justify-between gap-4 border-b border-gold/15 p-5">
          <div class="flex items-center gap-3">
            <Logo size={40} eager={false} />
            <div>
              <p class="font-display text-[11px] font-bold tracking-[0.14em]">AL SAFA RESIDENCE</p>
              <p class="font-mono text-[11px] text-gold">@{instagram.username}</p>
            </div>
          </div>
          <form method="dialog">
            <button class="flex h-10 w-10 items-center justify-center border border-gold/40 text-gold transition hover:border-ember hover:text-ember" aria-label="Close viewer">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
          </form>
        </div>
        <div class="flex-1 overflow-y-auto p-6">
          <p data-modal-caption class="whitespace-pre-line font-arabic text-[15px] leading-8 text-marble/85" dir="rtl" lang="ar"></p>
          <div data-modal-tags class="mt-5 flex flex-wrap justify-end gap-2" dir="rtl"></div>
        </div>
        <div class="flex items-center justify-between gap-3 border-t border-gold/15 p-5">
          <div class="flex gap-2">
            <button type="button" data-modal-prev class="flex h-10 w-10 items-center justify-center border border-gold/30 text-gold hover:border-gold" aria-label="Previous post">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            </button>
            <button type="button" data-modal-next class="flex h-10 w-10 items-center justify-center border border-gold/30 text-gold hover:border-gold" aria-label="Next post">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </button>
          </div>
          <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-gold !px-4 !py-3 !text-[10px]">Open Instagram</a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  type P = { image: string; body: string; tags: string[]; type: string; likes: number };
  const modal = document.getElementById('ig-modal') as HTMLDialogElement | null;
  if (modal) {
    const posts: P[] = JSON.parse(modal.dataset.posts || '[]');
    const img = modal.querySelector<HTMLImageElement>('[data-modal-img]')!;
    const cap = modal.querySelector<HTMLElement>('[data-modal-caption]')!;
    const tags = modal.querySelector<HTMLElement>('[data-modal-tags]')!;
    const reel = modal.querySelector<HTMLElement>('[data-modal-reel]')!;
    const typeEl = modal.querySelector<HTMLElement>('[data-modal-type]')!;
    let idx = 0;

    const render = () => {
      const p = posts[idx];
      if (!p) return;
      img.src = p.image;
      img.alt = p.body.split('\n')[0] || 'Instagram post';
      img.classList.toggle('animate-kenburns', p.type === 'reel');
      cap.textContent = p.body;
      tags.innerHTML = p.tags
        .map((t) => `<span class="border border-gold/30 px-2.5 py-1 font-mono text-[11px] text-gold">${t.replace(/</g, '')}</span>`)
        .join('');
      reel.classList.toggle('hidden', p.type !== 'reel');
      reel.classList.toggle('flex', p.type === 'reel');
      typeEl.textContent = p.type;
    };

    document.querySelectorAll<HTMLElement>('[data-ig-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        idx = Number(btn.dataset.igOpen || 0);
        render();
        if (typeof modal.showModal === 'function') modal.showModal();
        else modal.setAttribute('open', '');
        document.body.style.overflow = 'hidden';
      })
    );
    modal.addEventListener('close', () => (document.body.style.overflow = ''));
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    const step = (d: number) => {
      idx = (idx + d + posts.length) % posts.length;
      render();
    };
    modal.querySelector('[data-modal-prev]')?.addEventListener('click', () => step(-1));
    modal.querySelector('[data-modal-next]')?.addEventListener('click', () => step(1));
    modal.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
  }
</script>