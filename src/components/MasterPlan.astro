      { x: 20, y: 220, w: 220, h: 160, label: 'MASTER SUITE' },
      { x: 240, y: 220, w: 120, h: 160, label: 'EN-SUITE' },
      { x: 360, y: 220, w: 220, h: 160, label: 'BEDROOM 2' }
