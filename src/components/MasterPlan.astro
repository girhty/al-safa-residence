      { x: 20, y: 20, w: 300, h: 180, label: 'GRAND SALON' },
      { x: 320, y: 20, w: 140, h: 180, label: 'DINING' },
      { x: 460, y: 20, w: 120, h: 360, label: 'SKY TERRACE', glass: true },
      { x: 20, y: 200, w: 160, h: 180, label: 'MASTER SUITE' },
      { x: 180, y: 200, w: 110, h: 180, label: 'BATH' },
      { x: 290, y: 200, w: 170, h: 90, label: 'BEDROOM 2' },
      { x: 290, y: 290, w: 170, h: 90, label: 'BEDROOM 3' }
    ],
    hotspots: [
