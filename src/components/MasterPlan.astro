      { x: 390, y: 110, t: 'Dining', s: 'Statement pendant zone with oak-veneer ceiling detailing.' },
      { x: 520, y: 200, t: 'Sky Terrace', s: 'Frameless glass balustrade, porcelain outdoor decking and planter edges.' },
      { x: 100, y: 290, t: 'Master Suite', s: 'Upholstered wall panelling, dressing room and river-facing glazing.' },
      { x: 375, y: 245, t: 'Smart Home', s: 'Scene-based lighting, climate and blinds control from wall panels or mobile.' }
    ]
  },
