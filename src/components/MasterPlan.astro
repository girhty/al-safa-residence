    ],
    hotspots: [
      { x: 190, y: 120, t: 'Panoramic Salon', s: 'Double-height glazing framing the Shatt Al-Arab, book-matched stone feature.' },
      { x: 420, y: 80, t: 'Chef Kitchen', s: 'Island with waterfall quartz edge, premium integrated appliances, pantry.' },
      { x: 420, y: 180, t: 'Majlis', s: 'Dedicated reception room for family and guests with bespoke joinery.' },
      { x: 530, y: 200, t: 'Wrap Terrace', s: 'Private wraparound terrace with frameless glass and ambient lighting.' },
