---
import { contact } from '../data/site';
---

<div
  data-sticky-cta
  class="pointer-events-none fixed inset-x-0 bottom-4 z-40 flex translate-y-24 justify-center px-4 opacity-0 transition-all duration-700 ease-out-expo"
  role="region"
  aria-label="Quick booking actions"
>
  <div class="glass-dark pointer-events-auto flex w-full max-w-2xl items-center gap-2 p-2 shadow-[0_0_60px_-10px_rgba(255,159,28,0.45)] sm:gap-3">
    <span class="hidden items-center gap-3 pl-3 sm:flex">
      <span class="relative flex h-2 w-2"><span class="absolute h-2 w-2 animate-pulse-ring rounded-full bg-ember"></span><span class="h-2 w-2 rounded-full bg-ember"></span></span>
      <span class="font-mono text-[10px] tracking-[0.25em] text-marble/70">SALES GALLERY OPEN · {contact.hours}</span>
    </span>
    <div class="ml-auto flex w-full items-center gap-2 sm:w-auto">
      <a href={`tel:${contact.phoneTel}`} class="flex h-11 w-11 shrink-0 items-center justify-center border border-gold/40 text-gold transition hover:border-ember hover:text-ember" aria-label={`Call ${contact.phoneDisplay}`}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
      </a>
      <button type="button" data-brochure class="btn-ghost !h-11 flex-1 !px-3 !py-0 !text-[10px] sm:flex-none sm:!px-4">Brochure</button>
      <a href="#inquiry" class="btn-gold !h-11 flex-1 !px-3 !py-0 !text-[10px] sm:flex-none sm:!px-5">Book Viewing</a>
    </div>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const inquiry = document.getElementById('inquiry');
  if (bar) {
    let inInquiry = false;
    const update = () => {
      const heroEnd = hero ? hero.offsetHeight - window.innerHeight * 0.6 : 400;
      const show = window.scrollY > heroEnd && !inInquiry;
      bar.classList.toggle('opacity-0', !show);
      bar.classList.toggle('translate-y-24', !show);
    };
    if (inquiry) {
      new IntersectionObserver(
        (entries) => {
          inInquiry = entries[0]?.isIntersecting ?? false;
          update();
        },
        { threshold: 0.2 }
      ).observe(inquiry);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();

    bar.querySelector('[data-brochure]')?.addEventListener('click', () => {
      inquiry?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.dispatchEvent(new CustomEvent('alsafa:brochure'));
    });
  }
</script>