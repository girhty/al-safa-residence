---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { units, unitDisplay } from '../data/units';
import { localizePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = {
  ar: {
    eyebrow: 'أداة المقارنة',
    title: 'قارن بين الوحدات جنباً إلى جنب',
    intro: 'اختر وحدتين أو ثلاثاً من القائمة أو من بطاقات الوحدات أعلاه، وسيبقى اختيارك محفوظاً أثناء تنقلك في الموقع.',
    pick: 'اختر الوحدات للمقارنة (حتى 3 وحدات)',
    empty: 'اختر وحدتين للمقارنة',
    emptyBody: 'ستظهر هنا مقارنة المساحة وعدد الغرف والطابق والحالة والسعر.',
    one: 'اخترت وحدة واحدة — اختر وحدة أخرى على الأقل لبدء المقارنة.',
    ready: 'تُعرض الآن مقارنة بين {n} وحدات.',
    readyTwo: 'تُعرض الآن مقارنة بين وحدتين.',
    clear: 'مسح المقارنة',
    caption: 'جدول مقارنة الوحدات المختارة',
    attr: 'الخاصية',
    remove: 'إزالة {name} من المقارنة',
    view: 'عرض التفاصيل',
    scrollHint: 'اسحب الجدول أفقياً لعرض كل الوحدات',
    rows: { type: 'نوع الوحدة', size: 'المساحة', rooms: 'عدد الغرف', bathrooms: 'دورات المياه', floor: 'الطابق', status: 'الحالة', price: 'السعر' },
  },
  en: {
    eyebrow: 'Comparison tool',
    title: 'Compare units side by side',
    intro: 'Pick two or three units from the list or from the unit cards above. Your selection is kept while you browse the site.',
    pick: 'Choose units to compare (up to 3)',
    empty: 'Select two units to compare',
    emptyBody: 'Floor area, room count, floor, status and price will be compared here.',
    one: 'One unit selected — choose at least one more to start comparing.',
    ready: 'Now comparing {n} units.',
    readyTwo: 'Now comparing 2 units.',
    clear: 'Clear comparison',
    caption: 'Comparison table of selected units',
    attr: 'Attribute',
    remove: 'Remove {name} from comparison',
    view: 'View details',
    scrollHint: 'Swipe the table sideways to see every unit',
    rows: { type: 'Unit type', size: 'Floor area', rooms: 'Rooms', bathrooms: 'Bathrooms', floor: 'Floor', status: 'Status', price: 'Price' },
  },
}[lang];

const data = {
  labels: {
    empty: c.empty,
    one: c.one,
    ready: c.ready,
    readyTwo: c.readyTwo,
    caption: c.caption,
    attr: c.attr,
    remove: c.remove,
    view: c.view,
  },
  rows: Object.entries(c.rows),
  units: Object.fromEntries(
    units.map((u) => {
      const d = unitDisplay(u, lang);
      return [
        u.id,
        {
          name: d.name,
          href: localizePath(`/properties/${u.slug}/`, lang),
          type: d.type,
          size: d.size,
          rooms: d.rooms,
          bathrooms: d.bathrooms,
          floor: d.floor,
          status: d.status,
          price: d.price,
        },
      ];
    }),
  ),
};
---

<section id="compare" aria-labelledby="compare-heading" class="border-t border-sand bg-sand-50 py-16 lg:py-24">
  <div class="container-x">
    <SectionHeading id="compare-heading" eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

    <fieldset class="mt-8">
      <legend class="font-semibold text-river">{c.pick}</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {units.map((u) => (
          <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-2 rounded-full border border-river/25 bg-white px-4 font-medium text-river has-[:checked]:border-bronze has-[:checked]:bg-bronze/10">
            <input type="checkbox" data-compare-id={u.id} class="h-5 w-5 accent-[#95601F]" />
            {u.name[lang]}
          </label>
        ))}
      </div>
    </fieldset>

    <p data-compare-hint class="mt-6 font-medium text-river" aria-live="polite"></p>

    <div data-compare-empty class="mt-6 flex flex-col items-center rounded-3xl border-2 border-dashed border-river/25 bg-white px-6 py-12 text-center">
      <span class="grid h-14 w-14 place-items-center rounded-2xl bg-river-100 text-river"><Icon name="compare" class="h-7 w-7" /></span>
      <p class="mt-4 font-display text-xl font-bold text-river">{c.empty}</p>
      <p class="mt-2 max-w-md text-ink/80">{c.emptyBody}</p>
    </div>

    <p data-compare-scroll-hint hidden class="mt-6 text-sm text-ink/75 md:hidden">{c.scrollHint}</p>
    <div
      data-compare-table-wrap
      hidden
      role="region"
      tabindex="0"
      aria-labelledby="compare-heading"
      class="mt-3 overflow-x-auto rounded-3xl border border-sand bg-white"
    ></div>

    <button type="button" data-compare-clear hidden class="btn-ghost mt-6">
      <Icon name="x" class="h-5 w-5" />
      {c.clear}
    </button>
  </div>
  <script type="application/json" id="compare-data" set:html={JSON.stringify(data)} />
</section>

<script>
  import { getSelection, setSelection } from '../scripts/compare';

  type UnitRow = Record<string, string>;
  interface CompareData {
    labels: Record<string, string>;
    rows: [string, string][];
    units: Record<string, UnitRow>;
  }

  const root = document.getElementById('compare');
  const raw = document.getElementById('compare-data')?.textContent;
  if (root && raw) {
    const data = JSON.parse(raw) as CompareData;
    const wrap = root.querySelector<HTMLElement>('[data-compare-table-wrap]')!;
    const empty = root.querySelector<HTMLElement>('[data-compare-empty]')!;
    const hint = root.querySelector<HTMLElement>('[data-compare-hint]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-compare-clear]')!;
    const scrollHint = root.querySelector<HTMLElement>('[data-compare-scroll-hint]')!;

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    };

    function render() {
      const sel = getSelection().filter((id) => data.units[id]);
      const L = data.labels;
      hint.textContent = sel.length === 0 ? '' : sel.length === 1 ? L.one : sel.length === 2 ? L.readyTwo : L.ready.replace('{n}', String(sel.length));
      empty.hidden = sel.length >= 2;
      wrap.hidden = sel.length < 2;
      scrollHint.hidden = sel.length < 2;
      clear.hidden = sel.length === 0;
      wrap.replaceChildren();
      if (sel.length < 2) return;

      const table = el('table', 'w-full min-w-[36rem] border-collapse text-start');
      table.append(el('caption', 'sr-only', L.caption));
      const thead = el('thead');
      const hr = el('tr', 'bg-river text-ivory');
      const corner = el('th', 'p-4 text-start text-sm font-semibold', L.attr);
      corner.scope = 'col';
      hr.append(corner);
      sel.forEach((id) => {
        const u = data.units[id];
        const th = el('th', 'p-4 text-start align-top');
        th.scope = 'col';
        const name = el('span', 'block font-display text-base font-bold', u.name);
        const actions = el('span', 'mt-2 flex flex-wrap items-center gap-2');
        const link = el('a', 'inline-flex min-h-[44px] items-center text-sm font-medium text-sand underline underline-offset-4 hover:text-ivory', L.view);
        link.href = u.href;
        link.setAttribute('aria-label', `${L.view}: ${u.name}`);
        const rm = el('button', 'inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full text-sand hover:bg-white/10');
        rm.type = 'button';
        rm.setAttribute('aria-label', L.remove.replace('{name}', u.name));
        rm.innerHTML = '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
        rm.addEventListener('click', () => {
          setSelection(getSelection().filter((x) => x !== id));
          (root.querySelector<HTMLElement>('[data-compare-table-wrap]:not([hidden])') ?? hint).focus?.();
          hint.setAttribute('tabindex', '-1');
          hint.focus();
        });
        actions.append(link, rm);
        th.append(name, actions);
        hr.append(th);
      });
      thead.append(hr);
      const tbody = el('tbody');
      data.rows.forEach(([key, label], i) => {
        const tr = el('tr', i % 2 ? 'bg-sand-50' : 'bg-white');
        const th = el('th', 'p-4 text-start text-sm font-semibold text-ink/80', label);
        th.scope = 'row';
        tr.append(th);
        sel.forEach((id) => {
          const td = el('td', 'p-4 font-semibold text-river');
          const bdi = el('bdi', '', data.units[id][key]);
          td.append(bdi);
          tr.append(td);
        });
        tbody.append(tr);
      });
      table.append(thead, tbody);
      wrap.append(table);
    }

    clear.addEventListener('click', () => {
      setSelection([]);
      root.querySelector<HTMLInputElement>('fieldset input')?.focus();
    });
    window.addEventListener('compare:change', render);
    render();
  }
</script>