---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { business } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = {
  ar: {
    eyebrow: 'الموقع',
    title: 'في قلب البيبان بقضاء شط العرب',
    intro: 'نعرض هنا فقط المعلومات المؤكدة. سنضيف المرافق القريبة بعد التحقق منها ميدانياً.',
    verified: [
      { icon: 'map-pin', title: 'قضاء شط العرب — منطقة البيبان', body: 'موقع المشروع ومركز المبيعات الرئيسي في البصرة.' },
      { icon: 'building', title: 'فرع شارع السعدي', body: 'الفرع الثاني في بناية مركز البولينغ بمدينة البصرة.' },
    ],
    pendingTitle: 'المرافق القريبة',
    pending: [
      { icon: 'school', title: 'المدارس' },
      { icon: 'cart', title: 'الأسواق' },
      { icon: 'mosque', title: 'المساجد' },
      { icon: 'hospital', title: 'المستشفيات' },
    ],
    soon: 'قريباً — بانتظار التحقق',
    plus: 'رمز الموقع (Plus Code)',
    open: 'افتح الموقع في خرائط Google',
    newTab: '(يفتح في نافذة جديدة)',
  },
  en: {
    eyebrow: 'Location',
    title: 'In the heart of Al-Beban, Shatt Al-Arab',
    intro: 'Only verified information is shown here. Nearby amenities will be added once checked on the ground.',
    verified: [
      { icon: 'map-pin', title: 'Al-Beban, Shatt Al-Arab District', body: 'Project site and main sales centre in Basra.' },
      { icon: 'building', title: 'Al-Saadi Street branch', body: 'Second sales centre in the Bowling Centre building, Basra city.' },
    ],
    pendingTitle: 'Nearby amenities',
    pending: [
      { icon: 'school', title: 'Schools' },
      { icon: 'cart', title: 'Markets' },
      { icon: 'mosque', title: 'Mosques' },
      { icon: 'hospital', title: 'Hospitals' },
    ],
    soon: 'Coming soon — pending verification',
    plus: 'Plus Code',
    open: 'Open location in Google Maps',
    newTab: '(opens in a new tab)',
  },
}[lang];
---

<section aria-labelledby="location-heading" class="bg-sand-50 py-20 lg:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHeading id="location-heading" eyebrow={c.eyebrow} title={c.title} intro={c.intro} />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2" role="list">
        {c.verified.map((v) => (
          <li class="card flex gap-4 p-5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-river text-ivory"><Icon name={v.icon} /></span>
            <div>
              <h3 class="text-lg font-bold">{v.title}</h3>
              <p class="mt-1 text-ink/80">{v.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <h3 class="mt-10 text-xl font-bold">{c.pendingTitle}</h3>
      <ul class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4" role="list">
        {c.pending.map((p) => (
          <li class="rounded-2xl border border-dashed border-river/30 bg-white/60 p-4">
            <Icon name={p.icon} class="h-6 w-6 text-river" />
            <p class="mt-2 font-semibold text-river">{p.title}</p>
            <p class="text-sm text-ink/75">{c.soon}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-5">
      <div class="card h-full overflow-hidden">
        <div class="relative grid aspect-[4/3] place-items-center bg-river text-ivory">
          <svg viewBox="0 0 400 300" class="absolute inset-0 h-full w-full opacity-30" aria-hidden="true">
            <path d="M0 210 C 80 170, 160 250, 240 200 S 360 150, 400 180" stroke="#D9A560" stroke-width="18" fill="none" />
            <path d="M40 0 V300 M140 0 V300 M260 0 V300 M0 80 H400 M0 140 H400" stroke="#E8DCC8" stroke-width="1" />
          </svg>
          <div class="relative text-center">
            <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-bronze shadow-soft"><Icon name="map-pin" class="h-8 w-8 text-white" /></span>
            <p class="mt-3 font-display text-lg font-bold">{business.name[lang]}</p>
            <p class="text-sand">{business.address[lang]}</p>
          </div>
        </div>
        <div class="p-6">
          <p class="text-sm text-ink/75">{c.plus}</p>
          <p class="font-semibold text-river"><bdi dir="ltr">{business.plusCode}</bdi></p>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="btn-dark mt-5 w-full">
            <Icon name="map-pin" class="h-5 w-5" />
            {c.open}
            <span class="sr-only">{c.newTab}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>