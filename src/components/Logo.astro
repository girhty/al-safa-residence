---
import { instagram } from '../data/site';

interface Props {
  size?: number;
  class?: string;
  eager?: boolean;
}

const { size = 48, class: cls = '', eager = true } = Astro.props;
---

<span
  class={`relative inline-block shrink-0 ${cls}`}
  style={`width:${size}px;height:${size}px`}
  role="img"
  aria-label="Al Safa Residence logo"
>
  <span class="absolute inset-0 clip-hex bg-gradient-to-br from-gold-pale via-gold to-bronze"></span>
  <span class="absolute inset-[2px] clip-hex bg-obsidian"></span>
  <img
    src={instagram.profile_pic}
    alt=""
    width={size}
    height={size}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    referrerpolicy="no-referrer"
    class="absolute left-[4px] top-[4px] clip-hex object-cover"
    style={`width:${size - 8}px;height:${size - 8}px`}
    onerror="this.onerror=null;this.src='/favicon.svg'"
  />
</span>