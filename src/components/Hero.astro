---
import { places, instagram, contact, compact } from '../data/site';

const pois = [
  {
    zone: 'penthouses',
    pos: '-18,54,-14',
    label: 'Sky Crown Penthouses',
    tag: 'Signature',
    desc: 'Faceted hex-prism towers crowned in gold — double-height salons, private terraces and sweeping Shatt Al-Arab panoramas.'
  },
  {
    zone: 'towers',
    pos: '16,36,-16',
    label: 'Luxury Residential Towers',
    tag: 'Residences',
    desc: 'A choreographed cluster of sculpted towers with light-filled apartments designed for families who expect more.'
  },
  {
    zone: 'park',
    pos: '0,3,0',
    label: 'Central Park',
    tag: 'Landscape',
    desc: 'A hexagonal green heart with shaded promenades, a gold-ringed fountain and play gardens at the centre of the city.'
  },
  {
    zone: 'marina',
    pos: '42,2,4',
    label: 'Shatt Al-Arab Waterfront',
    tag: 'Riverside',
    desc: 'Timber piers and a riverfront promenade along the Shatt Al-Arab — sunset walks steps from home.'
  },
  {
    zone: 'pools',
    pos: '-2,3,23',
    label: 'Infinity Pools',
    tag: 'Wellness',
    desc: 'Resort-style pool terraces framed by gardens — a private retreat woven into the residential fabric.'
  },
  {
    zone: 'retail',
    pos: '11,7,13',
    label: 'Retail Promenade',
    tag: 'Lifestyle',
    desc: 'A boulevard of cafés, boutiques and daily conveniences connecting every quarter of the community.'
  }
];

const zones = [
  ['overview', 'Overview'],
  ['penthouses', 'Penthouses'],
  ['towers', 'Towers'],
  ['villas', 'Sky Villas'],
  ['park', 'Central Park'],
  ['marina', 'Waterfront']
];

const followers = compact(instagram.followers_count);
const fallbackImg = instagram.posts[0].image_url;
---

<section id="top" data-hero class="relative h-[190vh] bg-obsidian" aria-label="Al Safa Residence — cinematic 3D master plan">
  <div data-hero-sticky class="sticky top-0 h-[100svh] w-full overflow-hidden" style="--p:0">
    <!-- 3D Canvas -->
    <div id="hero-canvas" class="absolute inset-0 cursor-grab active:cursor-grabbing" aria-hidden="true"></div>

    <!-- No-WebGL fallback -->
    <div data-hero-fallback class="absolute inset-0 hidden">
      <img src={fallbackImg} alt="" class="h-full w-full object-cover opacity-40" referrerpolicy="no-referrer" />
      <div class="grid-lines absolute inset-0"></div>
    </div>

    <!-- Cinematic overlays -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(10,10,10,0.75)_100%)]"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-obsidian/90 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-obsidian via-obsidian/60 to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-full bg-gradient-to-r from-obsidian/85 via-obsidian/30 to-transparent lg:w-2/3"></div>

    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-40" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="hero-line" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#D4AF37" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="#D4AF37" stop-opacity="0.8"></stop>
          <stop offset="1" stop-color="#D4AF37" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <line x1="58" y1="100" x2="80" y2="0" stroke="url(#hero-line)" stroke-width="0.06" vector-effect="non-scaling-stroke"></line>
      <line x1="64" y1="100" x2="96" y2="0" stroke="url(#hero-line)" stroke-width="0.06" vector-effect="non-scaling-stroke"></line>
    </svg>

    <!-- POI markers tethered to 3D points -->
    <div class="pointer-events-none absolute inset-0 z-10" data-markers>
      {
        pois.map((p) => (
          <button
            type="button"
            data-poi
            data-pos={p.pos}
            data-zone={p.zone}
            data-title={p.label}
            data-desc={p.desc}
            data-tag={p.tag}
            class="group pointer-events-none absolute left-0 top-0 flex flex-col items-center opacity-0 will-change-transform"
            aria-label={`Explore ${p.label}`}
          >
            <span class="glass-dark whitespace-nowrap px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.25em] text-gold-light transition-all duration-500 group-hover:border-ember group-hover:text-ember sm:text-[10px]">
              {p.label}
            </span>
            <span class="h-6 w-px bg-gradient-to-b from-gold to-transparent" />
            <span class="relative flex h-3 w-3 items-center justify-center">
              <span class="absolute h-3 w-3 animate-pulse-ring rounded-full bg-ember/60" />
              <span class="h-2 w-2 rotate-45 bg-gold" />
            </span>
          </button>
        ))
      }
    </div>

    <!-- Headline -->
    <div
      class="pointer-events-none relative z-20 mx-auto flex h-full max-w-7xl flex-col justify-center px-5 pb-28 pt-28 lg:px-8"
      style="opacity: calc(1 - var(--p) * 2.4); transform: translate3d(0, calc(var(--p) * -140px), 0);"
    >
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="h-px w-10 bg-gold"></span> Shatt Al-Arab · Al-Beban · Basrah
      </p>
      <h1 class="headline max-w-4xl text-[clamp(1.9rem,6.2vw,5.4rem)] font-bold text-marble">
        <span class="block">The Next</span>
        <span class="block">Evolution</span>
        <span class="block">of Luxury</span>
        <span class="block text-gold-gradient">Living</span>
      </h1>
      <p class="mt-6 max-w-xl font-arabic text-lg text-marble/80 sm:text-xl" dir="rtl" lang="ar">حيث رفاهية السكن لمستقبل أفضل</p>
      <p class="mt-3 max-w-lg font-serif text-lg italic leading-relaxed text-marble/60 sm:text-xl">
        A master-planned residential city on the banks of the Shatt Al-Arab — a life you and your family deserve.
      </p>
      <div class="pointer-events-auto mt-9 flex flex-wrap gap-3">
        <a href="#masterplan" class="btn-gold">
          Explore Master Plan
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="#inquiry" class="btn-ghost">Book Private Presentation</a>
      </div>
    </div>

    <!-- Descent caption (scroll-scrubbed) -->
    <div
      class="pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-center px-6 text-center"
      style="opacity: calc((var(--p) - 0.45) * 3); transform: translate3d(0, calc((1 - var(--p)) * 60px), 0);"
      aria-hidden="true"
    >
      <p class="eyebrow mb-5">Penthouse Perspective · Sky Level</p>
      <p class="headline text-[clamp(1.6rem,5vw,4rem)] font-bold text-marble">Descend Into<br /><span class="text-gold-gradient">Your Skyline</span></p>
      <p class="mt-5 font-serif text-xl italic text-marble/70">From above the clouds to your private terrace.</p>
    </div>

    <!-- HUD card (desktop) -->
    <aside
      class="glass-dark clip-chamfer absolute bottom-24 right-5 z-30 hidden w-[340px] p-6 md:block lg:right-8"
      style="opacity: calc(1 - var(--p) * 2);"
      aria-label="Live project statistics"
    >
      <div class="flex items-center justify-between">
        <span class="font-mono text-[10px] tracking-[0.3em] text-gold">LIVE PROJECT HUD</span>
        <span class="flex items-center gap-2 font-mono text-[10px] tracking-widest text-marble/60">
          <span class="relative flex h-2 w-2"><span class="absolute h-2 w-2 animate-pulse-ring rounded-full bg-ember"></span><span class="h-2 w-2 rounded-full bg-ember"></span></span>
          SYNCED
        </span>
      </div>
      <div class="gold-line my-4 h-px opacity-60"></div>
      <div class="flex items-end gap-4">
        <p class="font-display text-5xl font-bold text-marble">{places.rating.toFixed(1)}</p>
        <div class="pb-1.5">
          <p class="text-lg leading-none tracking-[0.15em] text-gold" aria-label={`${places.rating} out of 5 stars`}>★★★★★</p>
          <p class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-marble/60">{places.user_ratings_total} Google Reviews</p>
        </div>
      </div>
      <dl class="mt-5 grid grid-cols-2 gap-px bg-gold/15">
        <div class="bg-obsidian/80 p-3">
          <dt class="font-mono text-[9px] tracking-[0.25em] text-marble/50">FOLLOWERS</dt>
          <dd class="mt-1 font-display text-lg text-marble">{followers}</dd>
        </div>
        <div class="bg-obsidian/80 p-3">
          <dt class="font-mono text-[9px] tracking-[0.25em] text-marble/50">SALES GALLERY</dt>
          <dd class="mt-1 text-sm font-semibold text-ember" data-open-status>Open now</dd>
        </div>
        <div class="bg-obsidian/80 p-3">
          <dt class="font-mono text-[9px] tracking-[0.25em] text-marble/50">BASRAH TIME</dt>
          <dd class="mt-1 font-mono text-sm text-marble" data-basrah-clock>--:--:--</dd>
        </div>
        <div class="bg-obsidian/80 p-3">
          <dt class="font-mono text-[9px] tracking-[0.25em] text-marble/50">HOURS</dt>
          <dd class="mt-1 font-mono text-sm text-marble">{contact.hours}</dd>
        </div>
      </dl>
      <p class="mt-4 font-mono text-[10px] tracking-[0.2em] text-marble/50">PLUS CODE · {contact.plusCode} · BASRAH, IQ</p>
    </aside>

    <!-- Zone navigator -->
    <div
      class="absolute inset-x-0 bottom-6 z-30 px-5 lg:px-8"
      style="opacity: calc(1 - var(--p) * 2.2);"
    >
      <div class="mx-auto flex max-w-7xl items-end justify-between gap-4">
        <nav aria-label="3D master plan zones" class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 lg:mx-0 lg:px-0">
          {
            zones.map(([id, label]) => (
              <button
                type="button"
                data-zone-btn
                data-zone={id}
                aria-pressed={id === 'overview' ? 'true' : 'false'}
                class="glass-dark shrink-0 px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.22em] text-marble/70 transition-all duration-500 hover:border-gold hover:text-gold-light aria-pressed:border-ember aria-pressed:text-ember"
              >
                {label}
              </button>
            ))
          }
        </nav>
        <div class="hidden shrink-0 flex-col items-center gap-2 lg:flex" aria-hidden="true">
          <span class="font-mono text-[9px] tracking-[0.35em] text-marble/50">SCROLL TO DESCEND</span>
          <span class="relative h-12 w-px overflow-hidden bg-white/10"><span class="absolute inset-x-0 top-0 h-1/2 animate-scroll-cue bg-gold"></span></span>
        </div>
      </div>
      <!-- Mobile compact stats -->
      <div class="mx-auto mt-3 flex max-w-7xl items-center gap-4 font-mono text-[10px] tracking-[0.18em] text-marble/60 md:hidden">
        <span class="text-gold">★ {places.rating.toFixed(1)}</span>
        <span>{places.user_ratings_total} REVIEWS</span>
        <span>{followers} FOLLOWERS</span>
      </div>
    </div>

    <!-- POI detail card -->
    <div
      data-poi-card
      class="glass-dark clip-chamfer pointer-events-none absolute left-5 right-5 top-24 z-40 translate-y-4 p-6 opacity-0 transition-all duration-700 ease-out-expo sm:left-auto sm:right-8 sm:w-[360px]"
      role="dialog"
      aria-modal="false"
      aria-labelledby="poi-title"
      aria-hidden="true"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ember" data-poi-tag>Signature</p>
          <h2 id="poi-title" class="mt-2 font-display text-base font-bold uppercase tracking-[0.12em] text-marble" data-poi-title>—</h2>
        </div>
        <button type="button" class="flex h-9 w-9 shrink-0 items-center justify-center border border-gold/40 text-gold transition hover:border-ember hover:text-ember" data-poi-close aria-label="Close details">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <div class="gold-line my-4 h-px opacity-60"></div>
      <p class="font-serif text-lg leading-relaxed text-marble/80" data-poi-desc>—</p>
      <div class="mt-5 flex gap-3">
        <a href="#masterplan" class="btn-gold !px-4 !py-3 !text-[10px]">Master Plan</a>
        <a href="#inquiry" class="btn-ghost !px-4 !py-3 !text-[10px]">Enquire</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { createCity, type ZoneKey } from '../scripts/city';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const sticky = hero.querySelector<HTMLElement>('[data-hero-sticky]')!;
    const wrap = hero.querySelector<HTMLElement>('#hero-canvas')!;
    const poiEls = Array.from(hero.querySelectorAll<HTMLElement>('[data-poi]'));
    const zoneBtns = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-zone-btn]'));
    const card = hero.querySelector<HTMLElement>('[data-poi-card]')!;
    const ready = () => window.dispatchEvent(new CustomEvent('city-ready'));

    const city = createCity(wrap, {
      scrollEl: hero,
      autoRotate: true,
      markers: poiEls.map((el) => ({ el, pos: (el.dataset.pos || '0,0,0').split(',').map(Number) })),
      onProgress: (p) => sticky.style.setProperty('--p', p.toFixed(3)),
      onReady: ready
    });

    if (!city) {
      hero.querySelector('[data-hero-fallback]')?.classList.remove('hidden');
      poiEls.forEach((el) => el.remove());
      ready();
    }

    const setZone = (z: string) => {
      city?.focus(z as ZoneKey);
      zoneBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.zone === z)));
    };
    const showCard = (el: HTMLElement) => {
      card.querySelector('[data-poi-title]')!.textContent = el.dataset.title || '';
      card.querySelector('[data-poi-desc]')!.textContent = el.dataset.desc || '';
      card.querySelector('[data-poi-tag]')!.textContent = el.dataset.tag || '';
      card.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      card.setAttribute('aria-hidden', 'false');
    };
    const hideCard = () => {
      card.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      card.setAttribute('aria-hidden', 'true');
    };

    poiEls.forEach((el) =>
      el.addEventListener('click', () => {
        setZone(el.dataset.zone || 'overview');
        showCard(el);
      })
    );
    zoneBtns.forEach((b) =>
      b.addEventListener('click', () => {
        setZone(b.dataset.zone || 'overview');
        const match = poiEls.find((p) => p.dataset.zone === b.dataset.zone);
        match ? showCard(match) : hideCard();
      })
    );
    card.querySelector('[data-poi-close]')?.addEventListener('click', () => {
      hideCard();
      setZone('overview');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && card.getAttribute('aria-hidden') === 'false') {
        hideCard();
        setZone('overview');
      }
    });

    // Live Basrah clock & opening status (09:00 – 21:30)
    const clockEl = hero.querySelector('[data-basrah-clock]');
    const statusEl = hero.querySelector('[data-open-status]');
    const tickClock = () => {
      const now = new Date();
      if (clockEl) clockEl.textContent = now.toLocaleTimeString('en-GB', { timeZone: 'Asia/Baghdad', hour12: false });
      const [h, m] = now
        .toLocaleTimeString('en-GB', { timeZone: 'Asia/Baghdad', hour: '2-digit', minute: '2-digit', hour12: false })
        .split(':')
        .map(Number);
      const mins = h * 60 + m;
      const open = mins >= 540 && mins < 1290;
      if (statusEl) {
        statusEl.textContent = open ? 'Open now' : 'Opens 09:00';
        statusEl.classList.toggle('text-ember', open);
        statusEl.classList.toggle('text-marble/70', !open);
      }
    };
    tickClock();
    window.setInterval(tickClock, 1000);
  }
</script>