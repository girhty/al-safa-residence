---
import SmartImage from './SmartImage.astro';
import Icon from './Icon.astro';
import { business } from '../data/site';
import { mediaById } from '../data/media';
import { localizePath, formatNumber, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const img = mediaById('g1');
const L = (p: string) => localizePath(p, lang);
const rating = formatNumber(business.rating, lang);
---

{lang === 'ar' ? (
  <section aria-labelledby="hero-heading" class="relative isolate overflow-hidden bg-river-900 text-ivory">
    {img && (
      <SmartImage
        src={img.src}
        srcset={img.srcset}
        sizes="100vw"
        alt={img.alt.ar}
        width={img.width}
        height={img.height}
        fill
        eager
        priority
        tone="dark"
        fallbackText={false}
        lang="ar"
        class="-z-20"
      />
    )}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-river-900 via-river-900/85 to-river-900/55 lg:bg-gradient-to-l lg:from-river-900 lg:via-river-900/80 lg:to-river-900/25"
      aria-hidden="true"
    ></div>
    <div class="container-x flex min-h-[34rem] flex-col justify-end py-14 sm:min-h-[38rem] lg:min-h-[42rem] lg:justify-center">
      <div class="max-w-2xl">
        <a href="#reviews-heading" class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-white/10 px-4 text-sm font-medium text-ivory backdrop-blur hover:bg-white/15">
          <Icon name="star" filled class="h-4 w-4 text-bronze-300" />
          <bdi>{rating}</bdi>
          <span>على تقييمات Google · {formatNumber(business.reviewCount, 'ar')} مراجعات</span>
        </a>
        <h1 id="hero-heading" class="mt-5 text-4xl font-extrabold text-ivory sm:text-5xl lg:text-6xl" style="line-height:1.4">
          مجمع الصفا السكني
          <span class="block text-bronze-300">حياة تستحقها لك ولعائلتك</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-sand sm:text-xl">
          أبراج سكنية حديثة في منطقة البيبان بقضاء شط العرب في البصرة، مع خيارات تمويل مصرفي ميسّرة لتملّك شقتك.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${L('/contact/')}#inquiry`} class="btn-primary px-8 text-lg">اطلب معاينة</a>
          <a href={L('/properties/')} class="btn border border-white/40 text-ivory hover:bg-white/10">استعرض الوحدات</a>
        </div>
        <p class="mt-10 flex items-start gap-3 border-s-4 border-bronze-300 ps-4 text-sand">
          <Icon name="bank" class="mt-1 h-5 w-5 shrink-0 text-bronze-300" />
          <span>تمويل عبر مصرف الرافدين بفترة سداد تصل إلى <bdi>20</bdi> عاماً ودفعة مقدّمة <bdi>25%</bdi>.</span>
        </p>
      </div>
    </div>
  </section>
) : (
  <section aria-labelledby="hero-heading" class="overflow-hidden bg-ivory">
    <div class="container-x grid items-center gap-12 py-12 lg:grid-cols-12 lg:gap-14 lg:py-20">
      <div class="lg:col-span-6">
        <p class="eyebrow">Al-Beban · Shatt Al-Arab · Basra</p>
        <h1 id="hero-heading" class="mt-4 text-4xl font-extrabold sm:text-5xl lg:text-[3.4rem]">
          A life your family deserves, at Al Safa Residence
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink/80">
          Modern residential towers in Basra, flexible bank financing and two sales centres ready to welcome you.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${L('/contact/')}#inquiry`} class="btn-primary px-8 text-lg">Request a viewing</a>
          <a href={L('/properties/')} class="btn-ghost">
            Explore units
            <Icon name="arrow" class="h-5 w-5" />
          </a>
        </div>
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-sand pt-6">
          <div>
            <dt class="text-sm text-ink/75">Google rating</dt>
            <dd class="font-display text-2xl font-bold text-river">{rating}<span class="text-base font-medium text-ink/75"> / 5</span></dd>
          </div>
          <div>
            <dt class="text-sm text-ink/75">Loan term up to</dt>
            <dd class="font-display text-2xl font-bold text-river">20 yrs</dd>
          </div>
          <div>
            <dt class="text-sm text-ink/75">Sales centres</dt>
            <dd class="font-display text-2xl font-bold text-river">2</dd>
          </div>
        </dl>
      </div>
      <div class="relative lg:col-span-6">
        {img && (
          <SmartImage
            src={img.src}
            srcset={img.srcset}
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt={img.alt.en}
            width={img.width}
            height={img.height}
            eager
            priority
            lang="en"
            class="rounded-[2rem] shadow-soft"
          />
        )}
        <a href="#reviews-heading" class="card absolute -bottom-6 start-4 flex min-h-[44px] items-center gap-3 px-5 py-3 shadow-soft sm:start-8">
          <Icon name="star" filled class="h-6 w-6 text-bronze" />
          <span class="text-sm"><strong class="text-river">{rating}</strong> on Google · {business.reviewCount} reviews</span>
        </a>
      </div>
    </div>
  </section>
)}